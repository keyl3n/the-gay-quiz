{
  "name": "the-gay-quiz",
  "version": "3.0.0",
  "description": "Are you gay? Cause I am",
  "license": "ISC",
  "author": "k3ylen",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "setup": "pnpm install",
    "preinstall": "npx only-allow pnpm",
    "test": "node --check index.js && pnpx eslint .",
    "lint": "pnpx eslint .",
    "bundle": "esbuild index.js --bundle --platform=node --outfile=build/bundle.js && terser build/bundle.js -c -m -o build/bundle.min.js",
    "build": "pnpm run bundle && node --build-sea sea-config.json"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "nanospinner": "^1.2.2",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "terser": "^5.49.2"
  }
}
